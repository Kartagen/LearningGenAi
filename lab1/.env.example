# Copy this file to `.env` and fill in your keys.

# Comet Opik (https://www.comet.com)
OPIK_API_KEY=
OPIK_WORKSPACE=

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=

# Optional override of the judge model (default = qwen/qwen3-next-80b-a3b-instruct)
JUDGE_MODEL=qwen/qwen3-next-80b-a3b-instruct
